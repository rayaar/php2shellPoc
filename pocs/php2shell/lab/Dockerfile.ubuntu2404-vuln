FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
# Install apache2 and PHP dependencies first, then downgrade mod_php to the vulnerable version
RUN apt-get update && apt-get install -y \
      apache2 libapache2-mod-php8.3 php8.3 php8.3-cli \
    && a2dismod mpm_event && a2enmod mpm_prefork php8.3 \
    && rm -rf /var/lib/apt/lists/*
# Downgrade to pre-patch version (8.3.6-0ubuntu0.24.04.12)
COPY debs/ /tmp/debs/
RUN dpkg -i --force-downgrade /tmp/debs/*.deb && rm -rf /tmp/debs
RUN rm -f /var/www/html/index.html
COPY app/index.php /var/www/html/index.php
COPY lab.ini /etc/php/8.3/apache2/conf.d/99-lab.ini
COPY prefork-multi.conf /etc/apache2/mods-available/mpm_prefork.conf
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf
EXPOSE 80
CMD ["apachectl", "-D", "FOREGROUND"]
